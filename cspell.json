{
  "version": "0.2",
  "language": "en,en-GB",
  "unknownWords": "report-common-typos",
  "files": ["src/**/*.ts", "bin/**/*.ts", "test/**/*.ts", "**/*.md"],
  "ignorePaths": [
    "**/node_modules/**", "**/dist/**", "**/.check/**", "pnpm-lock.yaml", "package.json",
    "CHANGELOG.md", ".plumbbob/**", ".worktrees/**", ".health/**", "docs/superpowers/**"
  ],
  "ignoreRegExpList": ["/v1[0-9a-f]{16}/g"],
  "words": ["emial"]
}
